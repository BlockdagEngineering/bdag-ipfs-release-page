[Unit]
Description=BlockDAG community IPFS release seeder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ipfs daemon --enable-gc
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
Nice=10
IOSchedulingClass=idle
MemoryMax=2G

[Install]
WantedBy=default.target
